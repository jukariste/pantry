<div class="mb-6 flex items-center justify-between">
  <%= link_to "← All meals", meals_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
  <%= button_to "Delete meal", @meal, method: :delete,
        form: { data: { turbo_confirm: "Delete this meal?" } },
        class: "text-sm text-red-600 cursor-pointer" %>
</div>

<h1 class="mb-4 text-2xl font-bold">Edit meal</h1>

<%= render "form", meal: @meal %>

<div class="mt-8">
  <h2 class="mb-4 text-xl font-bold">Foods</h2>

  <table class="min-w-full text-left">
    <thead>
      <tr class="border-b">
        <th class="py-2">Food</th>
        <th class="py-2">Quantity</th>
        <th class="py-2">kcal</th>
        <th class="py-2">carb</th>
        <th class="py-2">fat</th>
        <th class="py-2">protein</th>

        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @meal.meal_foods.includes(:food).each do |mf| %>
        <tr class="border-b">
          <td class="py-2"><%= mf.food.name %></td>
          <td class="py-2">
            <%= form_with model: [@meal, mf], class: "flex gap-2" do |f| %>
              <%= f.number_field :quantity, step: 0.1, min: 0.1, class: "w-24 rounded border px-2 py-1" %>
              <%= f.submit "Save", class: "rounded bg-gray-200 px-3 py-1 cursor-pointer" %>
            <% end %>
          </td>
          <td class="py-2"><%= number_with_precision(mf.kcal, precision: 0) %></td>
          <td class="py-2"><%= number_with_precision(mf.carbohydrate, precision: 0) %></td>
          <td class="py-2"><%= number_with_precision(mf.fat, precision: 0) %></td>
          <td class="py-2"><%= number_with_precision(mf.protein, precision: 0) %></td>

          <td class="py-2">
            <%= button_to "Remove", [@meal, mf], method: :delete, class: "text-red-600 cursor-pointer" %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr class="font-bold">
        <td class="py-2" colspan="2">Total</td>
        <td class="py-2"><%= number_with_precision(@meal.total_kcal, precision: 0) %></td>
        <td class="py-2"><%= number_with_precision(@meal.total_carbohydrate, precision: 0) %></td>
        <td class="py-2"><%= number_with_precision(@meal.total_fat, precision: 0) %></td>
        <td class="py-2"><%= number_with_precision(@meal.total_protein, precision: 0) %></td>

        <td></td>
      </tr>
    </tfoot>
  </table>

  <%= form_with model: [@meal, MealFood.new], class: "mt-6 flex items-end gap-2" do |f| %>
    <div>
      <%= f.label :food_id, "Food", class: "block text-sm" %>
      <%= f.collection_select :food_id, Food.order(:name), :id, :name,
            { prompt: "Select a food" }, class: "rounded border px-2 py-1" %>
    </div>
    <div>
      <%= f.label :quantity, "Quantity", class: "block text-sm" %>
      <%= f.number_field :quantity, step: 0.1, min: 0.1, class: "w-24 rounded border px-2 py-1" %>
    </div>
    <%= f.submit "Add food", class: "rounded bg-blue-600 px-4 py-1 text-white cursor-pointer" %>
  <% end %>
</div>