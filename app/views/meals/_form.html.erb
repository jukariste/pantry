<%= form_with model: meal, class: "flex flex-wrap items-start gap-2" do |f| %>
  <div>
    <%= f.text_field :name, placeholder: "Meal name",
          class: "rounded border px-2 py-1 #{'border-red-500' if meal.errors[:name].any?}" %>
    <% meal.errors.full_messages_for(:name).each do |message| %>
      <p class="mt-1 text-sm text-red-600"><%= message %></p>
    <% end %>
  </div>
  <%= f.submit class: "rounded bg-blue-600 px-4 py-1 text-white cursor-pointer" %>
<% end %>
