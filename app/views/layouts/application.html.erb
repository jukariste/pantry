<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Food Planner" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full bg-gray-50 text-gray-900 antialiased">
    <header class="border-b bg-white">
      <nav class="mx-auto flex max-w-3xl items-center gap-6 px-4 py-3">
        <%= link_to "Food Planner", root_path, class: "font-bold" %>
        <%= link_to "Foods", foods_path, class: "text-gray-600 hover:text-gray-900" %>
        <%= link_to "Meals", meals_path, class: "text-gray-600 hover:text-gray-900" %>
      </nav>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-8">
      <% if notice.present? %>
        <p class="mb-4 rounded bg-green-50 px-3 py-2 text-green-700"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="mb-4 rounded bg-red-50 px-3 py-2 text-red-700"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>