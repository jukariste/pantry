<h1 class="mb-2 text-2xl font-bold">Foods</h1>
<p class="mb-6 text-sm text-gray-500">Calories are per 100g.</p>

<div class="mb-8">
  <%= render "form", food: @food %>
</div>

<% if @foods.any? %>
  <ul class="divide-y rounded border bg-white">
    <% @foods.each do |food| %>
      <li>
        <%= link_to edit_food_path(food), class: "flex items-center justify-between px-4 py-3 hover:bg-gray-50" do %>
          <span class="font-medium"><%= food.name %></span>
          <span class="text-sm text-gray-500"><%= number_with_precision(food.kcal, precision: 1, strip_insignificant_zeros: true) %> kcal</span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-gray-500">No foods yet. Add one above.</p>
<% end %>