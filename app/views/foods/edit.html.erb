<div class="mb-6 flex items-center justify-between">
  <%= link_to "← All foods", foods_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
  <%= button_to "Delete food", @food, method: :delete,
        form: { data: { turbo_confirm: "Delete this food?" } },
        class: "text-sm text-red-600 cursor-pointer" %>
</div>

<h1 class="mb-4 text-2xl font-bold">Edit food</h1>

<%= render "form", food: @food %>