<%= form_with model: food, class: "flex flex-wrap items-start gap-2" do |f| %>
  <div>
    <%= f.text_field :name, placeholder: "Food name",
          class: "rounded border px-2 py-1 #{'border-red-500' if food.errors[:name].any?}" %>
    <% food.errors.full_messages_for(:name).each do |message| %>
      <p class="mt-1 text-sm text-red-600"><%= message %></p>
    <% end %>
  </div>

  <div>
    <%= f.number_field :kcal, placeholder: "kcal per 100g", step: :any, min: 0,
          class: "w-36 rounded border px-2 py-1 #{'border-red-500' if food.errors[:kcal].any?}" %>
    <% food.errors.full_messages_for(:kcal).each do |message| %>
      <p class="mt-1 text-sm text-red-600"><%= message %></p>
    <% end %>
  </div>

  <%= f.submit class: "rounded bg-blue-600 px-4 py-1 text-white cursor-pointer" %>
<% end %>